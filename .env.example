# ⚠️ Copier ce fichier vers `.env` puis renseigner les vraies valeurs.
# Ne JAMAIS committer de jeton en dur.

# URL de base de l'API Albert (Etalab)
ALBERT_API_URL=https://albert.api.etalab.gouv.fr/v1

# Jeton d'authentification API Albert (Obligatoire pour activer le copilote IA).
# > À RÉVOQUER PUIS RÉGÉNÉRER sur Etalab : un ancien jeton a été poussé dans git.
ALBERT_API_TOKEN=

# Modèle LLM utilisé (optionnel)
ALBERT_MODEL=mistral-small-3-2-24b-instruct-2506

# Paramètres HTTP du serveur (optionnel)
HOST=127.0.0.1
PORT=8000

# --- Synchronisation Hyperplanning (PRONOTE Campus, Université Le Havre) ---
# URL du portail mobile Hyperplanning (ne pas oublier le schéma https://)
HP_BASE_URL=https://hplanning.univ-lehavre.fr/mobile.enseignant

# Jeton et login issus du QR mobile (ex. rqcode-5545.png) — sensibles.
HP_TOKEN=
HP_LOGIN=

# SSO CAS Université Le Havre — pour l'authentification complète du portail.
CAS_BASE_URL=https://cas.univ-lehavre.fr/cas
CAS_USERNAME=
CAS_PASSWORD=

# Fréquence de synchronisation (minutes) — à utiliser par le planificateur.
HP_SYNC_INTERVAL_MIN=30